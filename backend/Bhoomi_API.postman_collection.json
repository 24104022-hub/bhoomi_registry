        {
          "name": "Register New Citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ravi Shankar\",\n  \"email\": \"ravi.shankar@example.com\",\n  \"password\": \"pass1234\",\n  \"phone\": \"+91 98888 77777\",\n  \"aadhaar\": \"XXXX-XXXX-9988\",\n  \"role\": \"citizen\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Get Current Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Google OAuth - Get Authorization URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/url?role=citizen&redirect=/app/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "url"],
              "query": [
                { "key": "role", "value": "citizen" },
                { "key": "redirect", "value": "/app/dashboard" }
              ]
            }
          }
        },
        {
          "name": "Google OAuth - Exchange Code (Auto saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Google OAuth JWT Token successfully set!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"sim_eyJlbWFpbCI6ImFsZXguY2l0aXplbkBnbWFpbC5jb20iLCJuYW1lIjoiQWxleCBSYW1hbiAoR29vZ2xlKSIsInJvbGUiOiJjaXRpemVuIiwiZ29vZ2xlSWQiOiJnaWQtMTIzNDU2In0=\",\n  \"state\": \"eyJyb2xlIjoiY2l0aXplbiIsInJlZGlyZWN0IjoiL2FwcC9kYXNoYm9hcmQifQ==\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google/exchange",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "exchange"]
            }
          }
        },
