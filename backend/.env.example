# ==============================================================================
# Bhoomi Land Registry - Environment Configuration Template
# Copy this file to '.env' and fill in the required credentials.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Compass / Atlas / Local MongoDB)
MONGO_STRING=mongodb://127.0.0.1:27017/bhoomi_land_registry

# Security & Authentication
JWT_SECRET=bhoomi_super_secret_jwt_key_2026_land_registry_secure
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (for Google One-Click Registration and Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Maps Platform (Optional: For satellite geocoding; interactive map works without key)
GOOGLE_MAPS_API_KEY=

# ==============================================================================
# Real Gmail SMTP Notification Configuration
# ==============================================================================
# Dispatches real official email notifications to citizen and officer inboxes for:
# - Registration submitted
# - Surveyor boundary verification
# - Registrar approval & Digital Deed issuance
# - Property ownership transfers
# - Appointment hearings
#
# HOW TO CONFIGURE REAL GMAIL DELIVERY:
# 1. Go to your Google Account: https://myaccount.google.com/security
# 2. Under 'How you sign in to Google', ensure 2-Step Verification is turned ON.
# 3. Visit https://myaccount.google.com/apppasswords directly.
# 4. Under 'App name', enter 'Bhoomi Registry' and click 'Create'.
# 5. Copy the generated 16-character code (e.g. 'abcd efgh ijkl mnop').
#    (Spaces are automatically stripped by the backend).
# 6. Fill in EMAIL_USER with your full Gmail address and EMAIL_PASS with the App Password below.
#
# Note: Never use your regular Google account password — Google strictly requires
# an App Password for SMTP access.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Bhoomi Land Registry" <your_email@gmail.com>

# Set to true ONLY if you want to use the Ethereal sandbox test account without Gmail credentials.
# By default (false), real Gmail delivery is enforced and missing credentials will fail clearly.
EMAIL_TEST_MODE=false
